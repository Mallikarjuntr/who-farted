{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "who-farted-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Post today’s Who Farted? case",
        "description": "Creates today’s case post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "who_farted_daily_dev"
  },
  "scheduler": {
    "tasks": {
      "daily-case": {
        "endpoint": "/internal/scheduler/daily-case",
        "cron": "0 0 * * *"
      }
    }
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT"
      ]
    },
    "journeys": true
  }
}
